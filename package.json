{
  "name": "@cope-market/pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run api:check",
    "api:sync": "tsx scripts/sync-api.ts",
    "api:check": "tsx scripts/sync-api.ts --check",
    "e2e": "playwright test",
    "verify:chain": "tsx scripts/verify-chain.ts",
    "shot": "tsx scripts/shot.ts",
    "verify:graph": "tsx scripts/verify-graph.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.42.0",
    "@serwist/next": "^9.2.1",
    "@tanstack/react-query": "^5.90.2",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "serwist": "^9.2.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
